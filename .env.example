# Telegram credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_CHANNEL=@your_channel_or_id

# Database (SQLite for local, PostgreSQL for prod)
DATABASE_URL=sqlite:///./japan_auctions.db

# Auth
ADMIN_PASSWORD=change_me_in_production
SECRET_KEY=generate_a_random_64char_string_here

# CORS (set to your frontend domain in production)
CORS_ORIGINS=http://localhost:5173,https://your-app.run.app
